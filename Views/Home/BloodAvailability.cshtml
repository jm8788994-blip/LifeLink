@model IEnumerable<LifeLink.Models.BloodStock>
@{
    ViewData["Title"] = "Blood Availability";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="about-hero">
    <div class="container">
        <h1>Blood Availability</h1>
        <p class="lead">Check live blood bags and units available across verified hospitals</p>
    </div>
</section>

<section class="table-section">
    <div class="container">
        <div class="table-card">
            <div class="card-header bg-white py-3">
                <div class="row align-items-center g-3">
                    <div class="col-md-5">
                        <h5 class="mb-0"><i class="fas fa-tint text-danger me-2"></i>Current Hospital Blood Stock</h5>
                    </div>
                    <div class="col-md-7">
                        <form method="get" asp-controller="Home" asp-action="BloodAvailability" class="row g-2">
                            <div class="col-md-4">
                                <select name="bloodGroup" class="form-select" onchange="this.form.submit()">
                                    <option value="All" selected="@(ViewBag.SelectedBloodGroup == "All")">All Blood Groups</option>
                                    <option value="A+" selected="@(ViewBag.SelectedBloodGroup == "A+")">A+</option>
                                    <option value="A-" selected="@(ViewBag.SelectedBloodGroup == "A-")">A-</option>
                                    <option value="B+" selected="@(ViewBag.SelectedBloodGroup == "B+")">B+</option>
                                    <option value="B-" selected="@(ViewBag.SelectedBloodGroup == "B-")">B-</option>
                                    <option value="AB+" selected="@(ViewBag.SelectedBloodGroup == "AB+")">AB+</option>
                                    <option value="AB-" selected="@(ViewBag.SelectedBloodGroup == "AB-")">AB-</option>
                                    <option value="O+" selected="@(ViewBag.SelectedBloodGroup == "O+")">O+</option>
                                    <option value="O-" selected="@(ViewBag.SelectedBloodGroup == "O-")">O-</option>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <div class="input-group">
                                    <input type="text" name="search" class="form-control" placeholder="Search hospital or city..." value="@ViewBag.SearchQuery" />
                                    <button class="btn btn-danger" type="submit"><i class="fas fa-search"></i></button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="bloodTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Blood Group</th>
                                <th>Available Units</th>
                                <th>Hospital / Blood Bank</th>
                                <th>Location</th>
                                <th>Expiry Date</th>
                                <th>Stock Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                int idx = 1;
                                foreach (var item in Model)
                                {
                                    var badgeClass = item.Status == "Available" ? "bg-success" :
                                                     item.Status == "Low Stock" ? "bg-warning text-dark" : "bg-danger";
                                    <tr>
                                        <td>@idx</td>
                                        <td><span class="badge bg-danger fs-6 px-2 py-1">@item.BloodGroup</span></td>
                                        <td><strong class="fs-6">@item.Quantity</strong> Units</td>
                                        <td>@(item.Hospital?.Name ?? "Central Blood Bank")</td>
                                        <td><i class="fas fa-map-marker-alt text-danger me-1"></i>@(item.Hospital?.Location ?? "Dhaka")</td>
                                        <td>@(item.ExpiryDate.HasValue ? item.ExpiryDate.Value.ToString("yyyy-MM-dd") : "N/A")</td>
                                        <td><span class="badge @badgeClass">@item.Status</span></td>
                                        <td>
                                            <a asp-controller="Home" asp-action="RecipientRegister" asp-route-bloodType="@item.BloodGroup" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-paper-plane me-1"></i>Request
                                            </a>
                                        </td>
                                    </tr>
                                    idx++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        <i class="fas fa-info-circle me-1"></i>No blood stock found matching your search criteria.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
