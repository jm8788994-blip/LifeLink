@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- About Hero -->
<section class="about-hero">
    <div class="container">
        <h1>About LifeLink</h1>
        <p class="lead">Connecting donors with those in need since 2024</p>
    </div>
</section>

<!-- About Content -->
<section class="section-padding">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <h3 class="mb-4">Our Mission</h3>
                <p class="text-muted">LifeLink is dedicated to creating a seamless platform for blood donation, connecting donors with recipients in need. Our mission is to ensure that no one suffers due to the unavailability of blood.</p>
                <p class="text-muted">We believe that every person has the power to save lives through blood donation. Our platform makes it easy for donors to register, stay connected, and donate when needed.</p>
                <h4 class="mt-4 mb-3">Key Features</h4>
                <ul class="list-unstyled">
                    <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Easy donor registration</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Real-time blood availability</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Direct donor-recipient matching</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Donation tracking and reminders</li>
                </ul>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h4 class="mb-4">Blood Type Compatibility</h4>
                        <table class="table table-bordered">
                            <thead class="table-danger">
                                <tr>
                                    <th>Blood Type</th>
                                    <th>Can Donate To</th>
                                    <th>Can Receive From</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td><strong>O-</strong></td><td>All Types</td><td>O-</td></tr>
                                <tr><td><strong>O+</strong></td><td>O+, A+, B+, AB+</td><td>O+, O-</td></tr>
                                <tr><td><strong>A-</strong></td><td>A-, A+, AB-, AB+</td><td>A-, O-</td></tr>
                                <tr><td><strong>A+</strong></td><td>A+, AB+</td><td>A+, A-, O+, O-</td></tr>
                                <tr><td><strong>B-</strong></td><td>B-, B+, AB-, AB+</td><td>B-, O-</td></tr>
                                <tr><td><strong>B+</strong></td><td>B+, AB+</td><td>B+, B-, O+, O-</td></tr>
                                <tr><td><strong>AB-</strong></td><td>AB-, AB+</td><td>All negatives</td></tr>
                                <tr><td><strong>AB+</strong></td><td>AB+</td><td>All Types</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="section-title">
            <h2>Our Team</h2>
            <p class="text-muted mt-3">Meet the people behind LifeLink</p>
        </div>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="team-card">
                    <img src="https://ui-avatars.com/api/?name=Team+Member+1&background=dc3545&color=fff&size=120" alt="Team Member" />
                    <h5 class="mt-3">Project Lead</h5>
                    <p class="text-muted">Team Leader</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="team-card">
                    <img src="https://ui-avatars.com/api/?name=Team+Member+2&background=28a745&color=fff&size=120" alt="Team Member" />
                    <h5 class="mt-3">Developer</h5>
                    <p class="text-muted">Backend Developer</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="team-card">
                    <img src="https://ui-avatars.com/api/?name=Team+Member+3&background=007bff&color=fff&size=120" alt="Team Member" />
                    <h5 class="mt-3">Designer</h5>
                    <p class="text-muted">UI/UX Designer</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="team-card">
                    <img src="https://ui-avatars.com/api/?name=Team+Member+4&background=ffc107&color=000&size=120" alt="Team Member" />
                    <h5 class="mt-3">Tester</h5>
                    <p class="text-muted">QA Engineer</p>
                </div>
            </div>
        </div>
    </div>
</section>
