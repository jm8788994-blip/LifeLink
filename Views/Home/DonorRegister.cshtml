@{
    ViewData["Title"] = "Become a Donor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="about-hero">
    <div class="container">
        <h1>Become a Donor</h1>
        <p class="lead">Register as a blood donor and save lives</p>
    </div>
</section>

<section class="form-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="form-card">
                    <div class="text-center mb-4">
                        <i class="fas fa-hand-holding-heart text-danger" style="font-size:3rem;"></i>
                        <h4 class="mt-2">Donor Registration Form</h4>
                        <p class="text-muted">Fill in your details to register as a blood donor</p>
                    </div>
                    <form asp-controller="Home" asp-action="DonorRegister" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Full Name *</label>
                                <input type="text" name="FullName" class="form-control" placeholder="Enter your full name" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email Address *</label>
                                <input type="email" name="Email" class="form-control" placeholder="Enter your email" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone Number *</label>
                                <input type="tel" name="PhoneNumber" class="form-control" placeholder="Enter your phone number" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Blood Type *</label>
                                <select name="BloodType" class="form-select" required>
                                    <option value="">Select Blood Type</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Date of Birth *</label>
                                <input type="date" name="DateOfBirth" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Address *</label>
                                <input type="text" name="Address" class="form-control" placeholder="Enter your address" required />
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="agreeTerms" required />
                                    <label class="form-check-label" for="agreeTerms">
                                        I agree to donate blood voluntarily and understand that my information will be used for blood donation purposes.
                                    </label>
                                </div>
                            </div>
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-danger btn-lg px-5">
                                    <i class="fas fa-heart me-2"></i>Register as Donor
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
