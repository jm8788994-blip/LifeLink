@model LifeLink.Models.User
@{
    ViewData["Title"] = "Receiver Dashboard - LifeLink";
    var requests = Model.BloodRequests.OrderByDescending(r => r.RequestDate).ToList();
    var hospitals = ViewBag.Hospitals as List<LifeLink.Models.Hospital> ?? new();
    var matchedDonors = ViewBag.MatchedDonors as List<LifeLink.Models.DonorProfile> ?? new();
    var notifications = ViewBag.Notifications as List<LifeLink.Models.Notification> ?? new();
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Receiver Header -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden">
        <div class="bg-dark text-white p-4">
            <div class="row align-items-center">
                <div class="col-md-8 d-flex align-items-center gap-3">
                    <div class="bg-danger text-white fw-bold rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 70px; height: 70px; font-size: 24px;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="fw-bold mb-0">@Model.Name</h2>
                            <span class="badge bg-danger"><i class="bi bi-heart-pulse me-1"></i>Recipient</span>
                        </div>
                        <p class="mb-0 text-white-50 small mt-1">
                            <i class="bi bi-telephone me-1"></i>@Model.Phone &nbsp;|&nbsp;
                            <i class="bi bi-envelope me-1"></i>@Model.Email
                        </p>
                    </div>
                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <button type="button" class="btn btn-danger fw-semibold shadow-sm px-4 py-2" data-bs-toggle="modal" data-bs-target="#newRequestModal">
                        <i class="bi bi-plus-circle me-1"></i>New Blood Request
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-3 bg-danger bg-opacity-10 text-danger fs-3">
                        <i class="bi bi-card-checklist"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Total Requests</div>
                        <h3 class="fw-bold text-dark mb-0">@requests.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-3 bg-warning bg-opacity-10 text-warning fs-3">
                        <i class="bi bi-hourglass-top"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Pending / In Progress</div>
                        <h3 class="fw-bold text-dark mb-0">@requests.Count(r => r.Status == "Pending" || r.Status == "Donor Accepted")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-3 bg-success bg-opacity-10 text-success fs-3">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Fulfilled / Completed</div>
                        <h3 class="fw-bold text-success mb-0">@requests.Count(r => r.Status == "Completed")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Blood Requests Table -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-droplet-fill text-danger me-2"></i>My Blood Requests
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (!requests.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-inbox fs-2 text-secondary mb-2 d-block"></i>
                            You have not submitted any blood requests yet.
                            <div class="mt-2">
                                <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#newRequestModal">Create One Now</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Blood</th>
                                        <th>Units</th>
                                        <th>Hospital / Location</th>
                                        <th>Urgency</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var req in requests)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-danger fs-6">@req.BloodGroup</span>
                                            </td>
                                            <td>@req.Quantity Bag(s)</td>
                                            <td>
                                                <strong>@(req.Hospital?.Name ?? "General")</strong><br />
                                                <small class="text-muted"><i class="bi bi-geo-alt"></i> @req.Location</small>
                                            </td>
                                            <td>
                                                @if (req.EmergencyLevel == "Critical")
                                                {
                                                    <span class="badge bg-danger">Critical</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">@req.EmergencyLevel</span>
                                                }
                                            </td>
                                            <td>
                                                @if (req.Status == "Completed")
                                                {
                                                    <span class="badge bg-success"><i class="bi bi-check me-1"></i>Completed</span>
                                                }
                                                else if (req.Status == "Donor Accepted")
                                                {
                                                    <span class="badge bg-primary"><i class="bi bi-person-check me-1"></i>Donor Accepted</span>
                                                }
                                                else if (req.Status == "Cancelled")
                                                {
                                                    <span class="badge bg-secondary">Cancelled</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pending</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (req.Status != "Completed" && req.Status != "Cancelled")
                                                {
                                                    <div class="d-inline-flex gap-1">
                                                        <form asp-action="CompleteRequest" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@req.RequestId" />
                                                            <button type="submit" class="btn btn-sm btn-success fw-semibold px-2 py-1" title="Mark Blood Donated and Reset Donor Interval">
                                                                <i class="bi bi-check2-circle me-1"></i>Donated
                                                            </button>
                                                        </form>
                                                        <form asp-action="CancelRequest" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@req.RequestId" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger py-1" title="Cancel Request">
                                                                <i class="bi bi-x"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                }
                                                else if (req.Status == "Completed")
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill py-1 px-2 small" onclick="openRatingModal(2, 'Ahmed Khan (Donor)', @req.RequestId)">
                                                        <i class="bi bi-star-fill text-warning me-1"></i>Rate Donor
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar: Matched Donors & Notifications -->
        <div class="col-lg-4">
            <!-- ML.NET AI Smart Ranked Donors -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-3 pb-2">
                    <div class="d-flex align-items-center justify-content-between">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-cpu-fill text-danger me-1"></i>AI Smart Donor Ranking
                        </h6>
                        <span class="badge bg-danger">ML.NET</span>
                    </div>
                    <small class="text-muted">Ranked by Compatibility, Distance, and Response History</small>
                </div>
                <div class="card-body p-0">
                    @{
                        var rankedDonors = ViewBag.RankedDonors as List<LifeLink.Models.RankedDonorResult> ?? new();
                    }
                    @if (!rankedDonors.Any())
                    {
                        <div class="p-3 text-center text-muted small">No compatible donors found nearby right now.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var d in rankedDonors)
                            {
                                <div class="list-group-item p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div>
                                            <span class="fw-bold text-dark">@d.User.Name</span>
                                            <span class="badge @d.BadgeClass ms-1" style="font-size: 10px;">@d.RecommendationBadge</span>
                                        </div>
                                        <span class="badge bg-danger fs-6">@d.DonorProfile.BloodGroup</span>
                                    </div>
                                    
                                    <div class="d-flex justify-content-between align-items-center small text-muted my-1">
                                        <span><i class="bi bi-geo-alt"></i> @d.DonorProfile.Location (@d.DistanceDisplay)</span>
                                        <span class="text-success fw-bold"><i class="bi bi-shield-check"></i> @d.MatchScore% Match</span>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top">
                                        <small class="text-muted">
                                            <i class="bi bi-activity text-primary me-1"></i>Response Prob: <strong>@d.ResponseProbability%</strong>
                                        </small>
                                        <div class="d-flex gap-1">
                                            <a asp-controller="Chat" asp-action="Index" asp-route-withUserId="@d.User.UserId" class="btn btn-xs btn-outline-primary py-1 px-2 rounded-pill small">
                                                <i class="bi bi-chat-dots me-1"></i>Chat
                                            </a>
                                            <a href="tel:@d.User.Phone" class="btn btn-xs btn-outline-success py-1 px-2 rounded-pill small">
                                                <i class="bi bi-telephone me-1"></i>Call
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Notifications -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-3 pb-2">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-bell text-warning me-1"></i>Notifications
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (!notifications.Any())
                    {
                        <div class="p-3 text-center text-muted small">No notifications.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush small">
                            @foreach (var n in notifications)
                            {
                                <li class="list-group-item p-3">
                                    <p class="mb-1 text-dark">@n.Message</p>
                                    <small class="text-muted">@n.CreatedAt.ToString("MMM dd, hh:mm tt")</small>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: New Blood Request -->
<div class="modal fade" id="newRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-droplet-half me-2"></i>Create Blood Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateRequest" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">Blood Group Needed</label>
                        <select name="bloodGroup" class="form-select" required>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold text-secondary">Units (Bags)</label>
                            <input type="number" name="quantity" class="form-control" value="1" min="1" max="10" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold text-secondary">Urgency Level</label>
                            <select name="emergencyLevel" class="form-select">
                                <option value="Critical">Critical (Immediate)</option>
                                <option value="Urgent" selected>Urgent (Within 24 hrs)</option>
                                <option value="Normal">Normal</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">Designated Hospital</label>
                        <select name="hospitalId" class="form-select" required>
                            @foreach (var h in hospitals)
                            {
                                <option value="@h.HospitalId">@h.Name (@h.Location)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">Location / Address</label>
                        <input type="text" name="location" class="form-control" placeholder="Hospital Ward / Room or Area" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">Required By Date</label>
                        <input type="date" name="requiredDate" class="form-control" value="@DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-semibold px-4">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Rating & Feedback Modal -->
<partial name="_RatingModal" />

@section Scripts {
    @if (TempData["RateDonorId"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                openRatingModal(@TempData["RateDonorId"], '@TempData["RateDonorName"]', @(TempData["RateRequestId"] ?? 0));
            });
        </script>
    }
}
