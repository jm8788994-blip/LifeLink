@model IEnumerable<LifeLink.Models.BloodStock>
@{
    ViewData["Title"] = "Manage Blood Bags";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var hospitals = ViewBag.Hospitals as List<LifeLink.Models.Hospital> ?? new List<LifeLink.Models.Hospital>();
}

<!-- Content Header -->
<div class="app-content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="mb-0">Blood Inventory Management</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Admin</a></li>
                    <li class="breadcrumb-item active">Blood Bags</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-lg-3 col-6">
                <div class="info-box shadow-sm">
                    <span class="info-box-icon bg-danger"><i class="bi bi-droplet"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Total Blood Bags</span>
                        <span class="info-box-number">@(ViewBag.TotalBags ?? 0)</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="info-box shadow-sm">
                    <span class="info-box-icon bg-success"><i class="bi bi-check-circle"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Available Units</span>
                        <span class="info-box-number">@(ViewBag.AvailableBags ?? 0)</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="info-box shadow-sm">
                    <span class="info-box-icon bg-warning"><i class="bi bi-exclamation-triangle"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Low Stock Alert</span>
                        <span class="info-box-number">@(ViewBag.LowStockBags ?? 0)</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="info-box shadow-sm">
                    <span class="info-box-icon bg-secondary"><i class="bi bi-x-circle"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Expired / Reserved</span>
                        <span class="info-box-number">@(ViewBag.ExpiredBags ?? 0)</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center g-2">
                    <div class="col-md-4">
                        <h3 class="card-title">Blood Stock Inventory (@(Model?.Count() ?? 0) Records)</h3>
                    </div>
                    <div class="col-md-5">
                        <form method="get" asp-controller="Admin" asp-action="BloodBags" class="d-flex gap-2">
                            <select name="bloodType" class="form-select form-select-sm" style="max-width: 140px;" onchange="this.form.submit()">
                                <option value="All" selected="@(ViewBag.BloodType == "All")">All Blood</option>
                                <option value="A+" selected="@(ViewBag.BloodType == "A+")">A+</option>
                                <option value="A-" selected="@(ViewBag.BloodType == "A-")">A-</option>
                                <option value="B+" selected="@(ViewBag.BloodType == "B+")">B+</option>
                                <option value="B-" selected="@(ViewBag.BloodType == "B-")">B-</option>
                                <option value="AB+" selected="@(ViewBag.BloodType == "AB+")">AB+</option>
                                <option value="AB-" selected="@(ViewBag.BloodType == "AB-")">AB-</option>
                                <option value="O+" selected="@(ViewBag.BloodType == "O+")">O+</option>
                                <option value="O-" selected="@(ViewBag.BloodType == "O-")">O-</option>
                            </select>
                            <div class="input-group input-group-sm">
                                <input type="text" name="search" class="form-control" placeholder="Search hospital/blood..." value="@ViewBag.Search" />
                                <button class="btn btn-danger" type="submit"><i class="bi bi-search"></i></button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-3 text-end d-flex gap-2 justify-content-end">
                        <a asp-controller="Admin" asp-action="ExportBloodStockCsv" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-file-earmark-excel me-1"></i>Export CSV
                        </a>
                        <button class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#addBloodBagModal">
                            <i class="bi bi-plus-lg me-1"></i>Add Blood Unit
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-danger">
                            <tr>
                                <th>Stock ID</th>
                                <th>Blood Type</th>
                                <th>Quantity (Units)</th>
                                <th>Hospital / Facility</th>
                                <th>Expiry Date</th>
                                <th>Status</th>
                                <th>Last Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var stock in Model)
                                {
                                    var badgeClass = stock.Status == "Available" ? "bg-success" :
                                                     stock.Status == "Low Stock" ? "bg-warning text-dark" : "bg-danger";
                                    <tr>
                                        <td>#@stock.StockId</td>
                                        <td><span class="badge bg-danger fs-6">@stock.BloodGroup</span></td>
                                        <td><strong>@stock.Quantity</strong> Units</td>
                                        <td>@(stock.Hospital?.Name ?? "Central Blood Storage")</td>
                                        <td>@(stock.ExpiryDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                        <td><span class="badge @badgeClass">@stock.Status</span></td>
                                        <td>@stock.LastUpdated.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <form asp-controller="Admin" asp-action="BloodBagDelete" asp-route-id="@stock.StockId" method="post" onsubmit="return confirm('Remove this blood stock item?');" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger" title="Delete Stock">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">No blood bags in inventory matching the filter.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Blood Bag Modal -->
<div class="modal fade" id="addBloodBagModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-droplet-fill me-2"></i>Add Blood Bag Stock</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="BloodBagAdd" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Hospital / Blood Bank *</label>
                        <select name="hospitalId" class="form-select" required>
                            @foreach (var h in hospitals)
                            {
                                <option value="@h.HospitalId">@h.Name (@h.Location)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Blood Type *</label>
                            <select name="bloodType" class="form-select" required>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Quantity (Units) *</label>
                            <input type="number" name="quantity" class="form-control" placeholder="Quantity" min="1" max="1000" value="10" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Expiry Date *</label>
                            <input type="date" name="expiryDate" class="form-control" value="@DateTime.UtcNow.AddDays(35).ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-select">
                                <option value="Available">Available</option>
                                <option value="Low Stock">Low Stock</option>
                                <option value="Reserved">Reserved</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-check-circle me-1"></i>Save Blood Bag</button>
                </div>
            </form>
        </div>
    </div>
</div>
