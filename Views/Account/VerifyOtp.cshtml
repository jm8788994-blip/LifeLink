@model LifeLink.Models.ViewModels.VerifyOtpViewModel
@{
    ViewData["Title"] = "Verify Account - LifeLink";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white text-center py-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white text-danger rounded-circle mb-2" style="width: 54px; height: 54px;">
                        <i class="bi bi-shield-check fs-2"></i>
                    </div>
                    <h3 class="fw-bold mb-0">Email Verification</h3>
                    <p class="small text-white-50 mb-0">Enter the 6-digit code sent to your email</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show small" role="alert">
                            <i class="bi bi-check-circle-fill me-1"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Info"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show small" role="alert">
                            <i class="bi bi-info-circle-fill me-1"></i>@TempData["Info"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Virtual In-App Mailbox / Dev Demo Preview (Zero setup / no webmail required) -->
                    @if (!string.IsNullOrEmpty(Model.DemoOtpHint))
                    {
                        <div class="card border-danger border-opacity-25 bg-danger bg-opacity-10 mb-4 rounded-3">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="badge bg-danger text-white"><i class="bi bi-envelope-paper me-1"></i>In-App Mail Preview</span>
                                    <small class="text-muted"><i class="bi bi-clock me-1"></i>Just Now</small>
                                </div>
                                <p class="small mb-1 text-secondary"><strong>To:</strong> <code>@Model.Email</code></p>
                                <p class="small mb-2 text-secondary"><strong>Subject:</strong> LifeLink Verification Code</p>
                                <div class="bg-white p-2 rounded border border-danger border-opacity-50 text-center">
                                    <div class="fs-4 fw-bold text-danger letter-spacing-lg">@Model.DemoOtpHint</div>
                                    <small class="text-muted">Click the button below to auto-fill</small>
                                </div>
                                <div class="text-center mt-2">
                                    <button type="button" class="btn btn-sm btn-danger px-3 rounded-pill" onclick="autoFillOtp('@Model.DemoOtpHint')">
                                        <i class="bi bi-magic me-1"></i>Auto-Fill Code
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <p class="text-muted small text-center mb-4">
                        We sent a verification code to <br /><strong class="text-dark">@Model.Email</strong>
                    </p>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                    <form asp-action="VerifyOtp" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Purpose" />
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-3 text-center">
                            <label asp-for="Code" class="form-label fw-bold text-secondary">Verification Code (6-Digits)</label>
                            <input asp-for="Code" id="otpCodeInput" maxlength="6" class="form-control form-control-lg text-center fw-bold fs-3 tracking-widest bg-light" placeholder="••••••" autofocus />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <!-- 5-Minute Expiry Countdown -->
                        <div class="text-center mb-4 text-muted small">
                            Code expires in: <span id="timerText" class="fw-bold text-danger">05:00</span>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-2 fw-semibold rounded-3 shadow-sm mb-3">
                            <i class="bi bi-check2-circle me-2"></i>Verify & Continue
                        </button>
                    </form>

                    <!-- Resend OTP Form -->
                    <form asp-action="ResendOtp" method="post" class="text-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@Model.Email" />
                        <input type="hidden" name="purpose" value="@Model.Purpose" />
                        <span class="text-muted small">Didn't receive the email? </span>
                        <button type="submit" id="resendBtn" class="btn btn-link text-danger p-0 small fw-semibold text-decoration-none">
                            Resend Code
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .tracking-widest {
        letter-spacing: 0.35em;
    }
    .letter-spacing-lg {
        letter-spacing: 0.25em;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function autoFillOtp(code) {
            document.getElementById('otpCodeInput').value = code;
        }

        // 5-minute countdown timer
        let timeLeft = 300;
        const timerText = document.getElementById('timerText');

        const interval = setInterval(function() {
            timeLeft--;
            if (timeLeft <= 0) {
                clearInterval(interval);
                timerText.textContent = "Expired";
                timerText.classList.remove("text-danger");
                timerText.classList.add("text-secondary");
            } else {
                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;
                timerText.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
            }
        }, 1000);
    </script>
}
