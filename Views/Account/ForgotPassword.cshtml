@model LifeLink.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password - LifeLink";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white text-center py-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white text-danger rounded-circle mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-key-fill fs-3"></i>
                    </div>
                    <h3 class="fw-bold mb-0">Reset Password</h3>
                    <p class="small text-white-50 mb-0">Enter your email to receive an OTP code</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold text-secondary">Registered Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control bg-light border-start-0 ps-0" placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-2 fw-semibold rounded-3 shadow-sm">
                            <i class="bi bi-send me-1"></i>Send OTP Code
                        </button>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-3">
                    <a asp-action="Login" class="text-muted small text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i>Back to Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
