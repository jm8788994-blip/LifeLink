@model LifeLink.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Set New Password - LifeLink";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white text-center py-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white text-danger rounded-circle mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </div>
                    <h3 class="fw-bold mb-0">New Password</h3>
                    <p class="small text-white-50 mb-0">Create a secure password</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                    <form asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Code" />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold text-secondary">New Password</label>
                            <input asp-for="NewPassword" class="form-control bg-light" placeholder="Min. 6 characters" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary">Confirm New Password</label>
                            <input asp-for="ConfirmPassword" class="form-control bg-light" placeholder="Repeat new password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-2 fw-semibold rounded-3 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i>Update Password
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
