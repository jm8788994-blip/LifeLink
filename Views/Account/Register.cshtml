@model LifeLink.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create an Account - LifeLink";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white text-center py-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white text-danger rounded-circle mb-2" style="width: 52px; height: 52px;">
                        <i class="bi bi-person-plus-fill fs-3"></i>
                    </div>
                    <h3 class="fw-bold mb-0">Join LifeLink Community</h3>
                    <p class="small text-white-50 mb-0">Register as a Blood Donor or Recipient</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Role Selector Tabs -->
                        <div class="mb-4 text-center">
                            <label class="form-label fw-bold d-block text-secondary mb-2">Registering As:</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="Role" id="roleDonor" value="Donor" @(Model.Role != "Receiver" ? "checked" : "") onchange="updateRoleUI()">
                                <label class="btn btn-outline-danger py-2 fw-semibold" for="roleDonor">
                                    <i class="bi bi-heart-pulse-fill me-1"></i> Blood Donor
                                </label>

                                <input type="radio" class="btn-check" name="Role" id="roleReceiver" value="Receiver" @(Model.Role == "Receiver" ? "checked" : "") onchange="updateRoleUI()">
                                <label class="btn btn-outline-danger py-2 fw-semibold" for="roleReceiver">
                                    <i class="bi bi-hospital me-1"></i> Patient / Receiver
                                </label>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-semibold text-secondary">Full Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="FullName" class="form-control bg-light border-start-0 ps-0" placeholder="e.g. Tanvir Rahman" />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold text-secondary">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control bg-light border-start-0 ps-0" placeholder="name@example.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold text-secondary">Contact Number</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="Phone" class="form-control bg-light border-start-0 ps-0" placeholder="+880 1700-000000" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="BloodGroup" class="form-label fw-semibold text-secondary">Blood Group</label>
                                <select asp-for="BloodGroup" class="form-select bg-light">
                                    <option value="A+">A+ (A Positive)</option>
                                    <option value="A-">A- (A Negative)</option>
                                    <option value="B+">B+ (B Positive)</option>
                                    <option value="B-">B- (B Negative)</option>
                                    <option value="AB+">AB+ (AB Positive)</option>
                                    <option value="AB-">AB- (AB Negative)</option>
                                    <option value="O+" selected>O+ (O Positive)</option>
                                    <option value="O-">O- (O Negative)</option>
                                </select>
                                <span asp-validation-for="BloodGroup" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Location" class="form-label fw-semibold text-secondary">Location / Area</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Location" class="form-control bg-light border-start-0 ps-0" placeholder="e.g. Chattogram, Dhaka" />
                                </div>
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6" id="dobSection">
                                <label asp-for="DateOfBirth" class="form-label fw-semibold text-secondary">Date of Birth</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control bg-light" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold text-secondary">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-lock"></i></span>
                                    <input asp-for="Password" class="form-control bg-light border-start-0 ps-0" placeholder="Min. 6 characters" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary">Confirm Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-check"></i></span>
                                    <input asp-for="ConfirmPassword" class="form-control bg-light border-start-0 ps-0" placeholder="Repeat password" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4">
                            <div class="alert alert-light border small text-muted">
                                <i class="bi bi-shield-exclamation text-warning me-2"></i>
                                An email containing a 6-digit OTP verification code will be dispatched to verify your account.
                            </div>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-2 mt-2 fw-semibold rounded-3 shadow-sm">
                            <i class="bi bi-check2-circle me-2"></i>Continue to Verification
                        </button>
                    </form>
                </div>

                <div class="card-footer bg-light text-center py-3">
                    <span class="text-muted small">Already registered? </span>
                    <a asp-action="Login" class="text-danger fw-semibold small text-decoration-none">Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateRoleUI() {
            // UI hooks if needed
        }
    </script>
}
