@model LifeLink.Models.Hospital
@{
    ViewData["Title"] = "Hospital Portal - LifeLink";
    var stocks = ViewBag.Stocks as List<LifeLink.Models.BloodStock> ?? new();
    var requests = ViewBag.Requests as List<LifeLink.Models.BloodRequest> ?? new();
    var donations = ViewBag.Donations as List<LifeLink.Models.DonationHistory> ?? new();
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Hospital Header -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden">
        <div class="bg-primary text-white p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white text-primary fw-bold rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 70px; height: 70px; font-size: 28px;">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="fw-bold mb-0">@Model.Name</h2>
                            <span class="badge bg-success"><i class="bi bi-patch-check-fill me-1"></i>@Model.VerificationStatus</span>
                        </div>
                        <p class="mb-0 text-white-50 small mt-1">
                            <i class="bi bi-geo-alt me-1"></i>@Model.Address, @Model.Location &nbsp;|&nbsp;
                            <i class="bi bi-telephone me-1"></i>@Model.Contact
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-3 bg-danger bg-opacity-10 text-danger fs-3">
                        <i class="bi bi-droplet-fill"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Total Blood Units In-Stock</div>
                        <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalBags Units</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-3 bg-warning bg-opacity-10 text-warning fs-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Low Stock Warnings</div>
                        <h3 class="fw-bold text-warning mb-0">@ViewBag.LowStockCount Groups</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-3 bg-primary bg-opacity-10 text-primary fs-3">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Pending Patient Requests</div>
                        <h3 class="fw-bold text-primary mb-0">@ViewBag.PendingCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- AI Demand Forecasting & Shortage Alerts (ML.NET) -->
    @{
        var aiForecasts = ViewBag.AiForecasts as List<LifeLink.Models.DemandForecastResult> ?? new();
        var criticalAlerts = aiForecasts.Where(f => f.ShortageRisk is "CRITICAL" or "HIGH").ToList();
    }
    @if (criticalAlerts.Any())
    {
        <div class="card border-danger border-opacity-50 shadow-sm rounded-4 mb-4 bg-danger bg-opacity-10">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger fs-6 p-2 rounded-circle"><i class="bi bi-robot"></i></span>
                        <h5 class="fw-bold text-danger mb-0">ML.NET AI Shortage Prediction Alert (PDF 4.7)</h5>
                    </div>
                    <span class="badge bg-danger text-white">Action Required</span>
                </div>
                <div class="row g-2">
                    @foreach (var alert in criticalAlerts)
                    {
                        <div class="col-md-6">
                            <div class="bg-white p-3 rounded-3 border border-danger border-opacity-25 shadow-xs">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-danger fs-6">@alert.BloodGroup</span>
                                    <span class="badge @alert.RiskBadgeClass">Risk: @alert.ShortageRisk</span>
                                </div>
                                <div class="small text-muted mb-1">
                                    Current Stock: <strong>@alert.CurrentStock bags</strong> | Forecasted Demand: <strong>@alert.ForecastedDemand units</strong>
                                </div>
                                <div class="small text-danger fw-semibold">
                                    <i class="bi bi-lightbulb me-1"></i>Recommendation: @alert.Recommendation
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Blood Group Inventory Grid -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-grid-3x3-gap-fill text-danger me-2"></i>Blood Bank Inventory by Blood Group
            </h5>
            <a asp-action="ExportStockCsv" asp-route-hospitalId="@Model.HospitalId" class="btn btn-sm btn-outline-success rounded-pill fw-semibold">
                <i class="bi bi-file-earmark-excel me-1"></i>Export Stock Report (CSV)
            </a>
        </div>
        <div class="card-body">
            <div class="row g-3">
                @foreach (var s in stocks)
                {
                    bool isLow = s.Quantity < 10;
                    <div class="col-6 col-md-3">
                        <div class="card border @(isLow ? "border-danger border-opacity-50 bg-danger bg-opacity-10" : "border-light bg-light") rounded-3 p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge @(isLow ? "bg-danger" : "bg-dark") fs-5">@s.BloodGroup</span>
                                <span class="badge @(isLow ? "bg-danger" : "bg-success")">
                                    @(isLow ? "Low Stock" : "Available")
                                </span>
                            </div>
                            <div class="mt-2 text-center">
                                <h2 class="fw-bold mb-0 @(isLow ? "text-danger" : "text-dark")">@s.Quantity</h2>
                                <small class="text-muted">Bags Available</small>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary mt-2 w-100" 
                                    data-bs-toggle="modal" data-bs-target="#editStockModal" 
                                    onclick="openStockModal(@s.StockId, '@s.BloodGroup', @s.Quantity, '@s.Status')">
                                <i class="bi bi-pencil-square me-1"></i>Update Stock
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Incoming Requests at this Hospital -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-inboxes-fill text-primary me-2"></i>Incoming Patient Requests
                    </h5>
                    <span class="badge bg-primary">@requests.Count Requests</span>
                </div>
                <div class="card-body p-0">
                    @if (!requests.Any())
                    {
                        <div class="p-4 text-center text-muted">No blood requests assigned to this hospital currently.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Patient</th>
                                        <th>Blood</th>
                                        <th>Urgency</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in requests)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@r.Receiver?.Name</strong><br />
                                                <small class="text-muted"><i class="bi bi-telephone"></i> @r.Receiver?.Phone</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-danger">@r.BloodGroup</span> (@r.Quantity bags)
                                            </td>
                                            <td>
                                                <span class="badge @(r.EmergencyLevel == "Critical" ? "bg-danger" : "bg-warning text-dark")">
                                                    @r.EmergencyLevel
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @(r.Status == "Fulfilled" ? "bg-success" : "bg-secondary")">
                                                    @r.Status
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                @if (r.Status != "Fulfilled" && r.Status != "Cancelled")
                                                {
                                                    <form asp-action="FulfillRequest" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="requestId" value="@r.RequestId" />
                                                        <button type="submit" class="btn btn-sm btn-success fw-semibold px-2">
                                                            <i class="bi bi-check2-circle me-1"></i>Fulfill
                                                        </button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Donations at this Hospital -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-3 pb-2">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-journal-check text-success me-2"></i>Completed Donations Log
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (!donations.Any())
                    {
                        <div class="p-3 text-center text-muted small">No donation records found.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush small">
                            @foreach (var don in donations)
                            {
                                <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold text-dark">@(don.Donor?.User?.Name ?? "Anonymous Donor")</div>
                                        <div class="text-muted">Blood Group: @(don.Donor?.BloodGroup ?? "Unknown")</div>
                                    </div>
                                    <div class="text-end">
                                        <a asp-controller="Donor" asp-action="Certificate" asp-route-donationId="@don.DonationId" target="_blank" class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2 small mb-1">
                                            <i class="bi bi-award me-1"></i>Certificate
                                        </a><br />
                                        <small class="text-muted">@don.DonationDate.ToString("MMM dd, yyyy")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Update Stock -->
<div class="modal fade" id="editStockModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-danger text-white">
                <h6 class="modal-title fw-bold" id="stockModalTitle">Update Blood Stock</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateStock" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="stockId" id="modalStockId" />
                <div class="modal-body p-3">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Quantity (Bags)</label>
                        <input type="number" name="quantity" id="modalQuantity" class="form-control" min="0" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold small text-secondary">Inventory Status</label>
                        <select name="status" id="modalStatus" class="form-select">
                            <option value="Available">Available</option>
                            <option value="Low Stock">Low Stock</option>
                            <option value="Reserved">Reserved</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger fw-semibold px-3">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openStockModal(stockId, bloodGroup, quantity, status) {
            document.getElementById('modalStockId').value = stockId;
            document.getElementById('stockModalTitle').innerText = 'Update Stock - ' + bloodGroup;
            document.getElementById('modalQuantity').value = quantity;
            document.getElementById('modalStatus').value = status || 'Available';
        }
    </script>
}
